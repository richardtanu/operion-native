          "fontWeight": "700"
        },
        {
          "type": "text",
          "id": "hyEmn",
          "name": "Subtitle",
          "fill": "$ink-secondary",
          "textGrowth": "fixed-width",
          "width": 900,
          "content": "Same fields, same actions, same backend rules as the web-console wireframes above — only the shell changed: nav bars, drill-down lists, bottom-pinned primary actions, single-column forms.",
          "fontFamily": "$font",
          "fontSize": 13,
          "fontWeight": "normal"
        },
        {
          "type": "frame",
          "id": "M1Iet",
          "name": "Platform Flags",
          "width": 900,
          "layout": "vertical",
          "gap": 10,
          "children": [
            {
              "id": "yzzbD",
              "type": "ref",
              "ref": "QfPQH",
              "name": "Callout — Platform override",
              "stroke": "$gap",
              "fill": "$gap-soft",
              "width": "fill_container",
              "descendants": {
                "knoLi": {
                  "fill": "$gap"
                },
                "z13SH": {
                  "content": "Platform override, flagged not silently made: all 8 records in the source inventory are tagged Platform: Web console — none is marked mobile. That tag was a gate-verified finding, not an open question, so redrawing the module as mobile is a real divergence made on explicit direction, not inferred. Worth a note back to whoever owns the inventory doc."
                }
              }
            },
            {
              "id": "bhjqS",
              "type": "ref",
              "ref": "QfPQH",
              "name": "Callout — PROC-05 contradiction",
              "stroke": "$gap",
              "fill": "$gap-soft",
              "width": "fill_container",
              "descendants": {
                "knoLi": {
                  "fill": "$gap"
                },
                "z13SH": {
                  "content": "PROC-05 specifically contradicts this: its own record says \"Web console (outlet back-office, not the mobile scan loop) — this is a paperwork/reconciliation step, not a barcode action.\" Drawn as mobile below anyway per direction, but that line was written deliberately to keep receipt logging off mobile — flag before it ships."
                }
              }
            }
          ]
        },
